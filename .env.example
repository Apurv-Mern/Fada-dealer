# Node backend base URL (no trailing slash).
# Direct mode: browser calls this origin. Proxy mode: Nginx / next rewrite upstream.
NEXT_PUBLIC_API_URL=https://api.fadaid.com

# When true, browser calls same-origin `/api/*` (no CORS). Nginx (prod) or
# next.config rewrites (next dev) forward to NEXT_PUBLIC_API_URL.
# When false (default), browser calls NEXT_PUBLIC_API_URL directly.
NEXT_PUBLIC_USE_PROXY=false

# Domain features (branches/outlets, employees, dealership, …).
# Default when unset is mocks ON (isMockMode() === true unless this is "false").
# Set to false when wiring real Node `/dealers/*` APIs (rebuild / restart after change).
# Auth is separate: when proxy or NEXT_PUBLIC_API_URL is set, dealer auth calls the
# real Node `/dealer/auth/*` endpoints (isRealDealerAuthEnabled). You can therefore
# use real login while domain pages still read mocks.
NEXT_PUBLIC_USE_MOCKS=true

# Refresh tokens may be stored in sessionStorage when the auth API returns them.
# There is no silent refresh/renew flow yet — authenticated 401 clears the session
# and redirects to login.
